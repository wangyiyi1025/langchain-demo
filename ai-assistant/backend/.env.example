# 应用配置
APP_NAME=AI Assistant
APP_VERSION=1.0.0
DEBUG=True

# API配置
API_PREFIX=/api/v1

# 千问配置（必填）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=2000

# Agent配置
AGENT_MAX_ITERATIONS=5
AGENT_VERBOSE=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log