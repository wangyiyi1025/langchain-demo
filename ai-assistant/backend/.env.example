# =============================================================================
# Smart Chat BI Assistant - 环境配置文件
# =============================================================================
#
# 📌 重要提示：
# 1. 复制此文件为 .env 并根据你的环境修改配置
# 2. 根据使用的模型类型选择合适的 AGENT_TYPE：
#    - 本地模型（Ollama/vLLM/LM Studio）→ AGENT_TYPE=react
#    - OpenAI/GPT 等云端模型 → AGENT_TYPE=tool_calling
#
# =============================================================================

# 应用配置
APP_NAME=Smart Chat BI Assistant
APP_VERSION=1.0.0
DEBUG=True

# API配置
API_PREFIX=/api/v1

# LLM配置（OpenAI兼容接口）
# 支持任何兼容OpenAI API的大模型服务
# 以下提供了几种常见配置示例，选择一种并取消注释：

# ===== 示例1: Ollama本地模型（推荐用于本地开发） =====
# 💡 使用此配置时，请设置: AGENT_TYPE=react
OPENAI_API_KEY=sk-dummy-key
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:latest
LLM_PROVIDER=ollama

# ===== 示例2: vLLM本地部署 =====
# 💡 使用此配置时，请设置: AGENT_TYPE=react
# OPENAI_API_KEY=sk-dummy-key
# OPENAI_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_PROVIDER=vllm

# ===== 示例3: LM Studio =====
# 💡 使用此配置时，请设置: AGENT_TYPE=react
# OPENAI_API_KEY=sk-dummy-key
# OPENAI_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b-instruct
# LLM_PROVIDER=lmstudio

# ===== 示例4: 阿里云千问 =====
# 💡 使用此配置时，可以尝试: AGENT_TYPE=tool_calling（如果模型支持）或 AGENT_TYPE=react
# OPENAI_API_KEY=your-dashscope-api-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_PROVIDER=qwen

# ===== 示例5: OpenAI官方 =====
# 💡 使用此配置时，请设置: AGENT_TYPE=tool_calling（推荐，充分利用 function calling）
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4
# LLM_PROVIDER=openai

# 通用参数配置
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# Agent配置
# AGENT_TYPE: Agent类型选择
#   - "react": ReAct Agent（推荐用于本地模型，如 Ollama/qwen/LM Studio）
#              基于文本解析，通过 Thought/Action/Action Input 格式工作
#              不依赖特定API格式，兼容性好
#   - "tool_calling": Tool Calling Agent（推荐用于 OpenAI/GPT 等支持 function calling 的模型）
#              使用 OpenAI function calling 格式，支持多轮对话历史
#              需要模型原生支持 function calling 功能
AGENT_TYPE=react
AGENT_MAX_ITERATIONS=5
AGENT_VERBOSE=True
AGENT_HANDLE_PARSING_ERRORS=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# MySQL数据库配置（用于系统元数据存储）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=smart_chat_bi_meta
MYSQL_CHARSET=utf8mb4

# StarRocks数据库配置（用于数据分析）
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
STARROCKS_USER=admin
STARROCKS_PASSWORD=123456

# JWT认证配置
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440